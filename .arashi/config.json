{
  "$schema": "https://unpkg.com/arashi/schema/config.schema.json",
  "version": "1.0.0",
  "reposDir": "./repos",
  "worktreesDir": ".arashi/worktrees",
  "defaults": {
    "create": {
      "launch": true,
      "launchMode": "sesh"
    },
    "switch": {
      "launchMode": "sesh"
    }
  },
  "repos": {
    "arashi-docs": {
      "path": "repos/arashi-docs",
      "gitUrl": "git@github.com:corwinm/arashi-docs.git"
    },
    "arashi-vscode": {
      "path": "repos/arashi-vscode",
      "gitUrl": "git@github.com:corwinm/arashi-vscode.git"
    },
    "arashi": {
      "path": "repos/arashi",
      "gitUrl": "git@github.com:corwinm/arashi.git"
    },
    "arashi-skills": {
      "path": "repos/arashi-skills",
      "gitUrl": "git@github.com:corwinm/arashi-skills.git"
    }
  }
}
